# Offline demo only. Production requires signatures and a strong AUTH_SECRET.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/content
REDIS_URL=redis://redis:6379/0
AUTH_SECRET=change-me
GENERATION_PROVIDER=mock
FAL_API_KEY=
FAL_MODEL_IMAGE=fal-ai/flux/dev
FAL_MODEL_VIDEO=fal-ai/wan-25-preview/image-to-video
FAL_MODEL_IMAGE_TO_IMAGE=fal-ai/flux/dev/image-to-image
FAL_MODEL_TEXT_TO_VIDEO=fal-ai/wan-25-preview/text-to-video
# Optional separate Fal account and per-mode model overrides (JSON).
FAL_FALLBACK_API_KEY=
FAL_FALLBACK_MODELS={}
API_TIMEOUT_SECONDS=4.5
ENQUEUE_TIMEOUT_SECONDS=1
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_RECOVERY_TIMEOUT_SECONDS=30
WEBHOOK_ATTEMPTS=5
WEBHOOK_INTERVAL_SECONDS=15
WEBHOOK_PREPARATION_TIMEOUT_SECONDS=30
REQUIRE_WEBHOOK_SIGNATURE=false
LOG_DIR=logs
PROCESSING_TIMEOUT_SECONDS=600
PROVIDER_OPERATION_TIMEOUT_SECONDS=300
RECOVERY_INTERVAL_SECONDS=15
RECOVERY_BATCH_SIZE=100
RECOVERY_HEALTH_MAX_AGE_SECONDS=90
RECOVERY_METRICS_PORT=8001
WORKER_METRICS_PORT=8002
